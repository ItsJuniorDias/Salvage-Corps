    "camp.flavor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“The artillery sounds far away. Someone lit an oil lantern. The smell of bad coffee mixes with wet earth.”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“El estruendo de la artillería suena lejano. Alguien encendió un farol de aceite. El olor a café malo se mezcla con la tierra mojada.”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“O barulho da artilharia parece longe. Alguém acendeu uma lanterna a óleo. O cheiro de café ruim mistura-se com o de terra molhada.”"
          }
        }
      }
    },
