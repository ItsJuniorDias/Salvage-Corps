    "· %@": {
      "comment": "A line in the duel recap, with a period prefix.",
      "isCommentAutoGenerated": true
    },
    "· %lld": {
      "comment": "A rating indicator of the opponent.",
      "isCommentAutoGenerated": true
    },
    "“%@”": {
      "comment": "A label that describes the flavor text of a card upgrade.",
      "isCommentAutoGenerated": true
    },
    "“Você olha pra sua mão. Percebe algo sobre %@. Algo que poderia fazer diferente.”": {
      "comment": "A quote that describes the player's current card.",
      "isCommentAutoGenerated": true
    },
    "(%@%lld)": {
      "comment": "A delta de rating.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "(%1$@%2$lld)"
          }
        }
      }
    },
    "%@:": {
      "comment": "A label and a progress bar that shows a player's health. The argument is the string “HP” or the string “MORAL”.",
      "isCommentAutoGenerated": true
    },
    "%@%lld": {
      "comment": "A status effect icon and its duration. The icon is generated based on the status type. The duration is shown as a number in parentheses. The argument is the string “🛡”, the string “👁”, the string “💤” or the string “🕳”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$lld"
          }
        }
      }
    },
    "%lld": {
      "comment": "A label that shows the player's block value.",
      "isCommentAutoGenerated": true
    },
    "%lld/%lld": {
      "comment": "A label displaying the current and maximum values of a stat. The argument is the current value, the second argument is the maximum value.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld/%2$lld"
          }
        }
      }
    },
    "+%lld": {
      "comment": "A label that appears when the player heals, showing the amount healed.",
      "isCommentAutoGenerated": true
    },
